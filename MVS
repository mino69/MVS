-- [[ CORE LOGIC ]] --

local function isInLobby()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local dist = (char.HumanoidRootPart.Position - Config.LobbyCenter).Magnitude
		return dist < Config.LobbyThreshold
	end
	return false
end

local function teleport(pos)
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local dist = (char.HumanoidRootPart.Position - pos).Magnitude
		if dist > 8 then
			if tick() - lastTeleportTime > Config.TeleportCooldown then
				char.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
				lastTeleportTime = tick()
			end
		end
	end
end

local function fireRemote(target)
	if not target or not target.Character then return end
	local hitPart = target.Character:FindFirstChild(Config.TargetPart)
	if not hitPart then return end
	local throwRemote = Remotes:FindFirstChild("ThrowHit")
	if not throwRemote then return end

	local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
	local backpackTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")

	if Config.AutoEquip and not tool and backpackTool then
		local oldParent = backpackTool.Parent
		backpackTool.Parent = LocalPlayer.Character
		task.wait() 
		throwRemote:FireServer(hitPart, hitPart.Position)
		task.wait()
		backpackTool.Parent = oldParent
	else
		throwRemote:FireServer(hitPart, hitPart.Position)
	end
end

local function getPadStats(padModel)
	local others = 0
	local cap = 0
	local amIHere = false
	local char = LocalPlayer.Character
	local padPart = padModel:FindFirstChild("Pad")
	if padPart and char and char:FindFirstChild("HumanoidRootPart") then
		if (char.HumanoidRootPart.Position - padPart.Position).Magnitude < 8 then amIHere = true end
	end
	for _, child in ipairs(padModel:GetChildren()) do
		if child:IsA("ObjectValue") then
			cap = cap + 1
			if child.Value ~= nil then
				if child.Value == LocalPlayer then amIHere = true else others = others + 1 end
			end
		end
	end
	return others, cap, amIHere
end

local function findBestPad()
	local lobby = workspace:FindFirstChild("Lobby")
	local ringsGroup = lobby and lobby:FindFirstChild("DuelRingsGroup")
	if not ringsGroup then return nil end
	
	local bestPadTarget = nil
	local bestScore = -10000
	local currentRingScore = -10000
	local isMatchStarting = false

	for _, ringFolder in ipairs(ringsGroup:GetChildren()) do
		local ringOtherOccupants = 0
		local totalCapacity = 0
		local amIInThisRing = false
		local potentialPad = nil
		local hasActiveCountdown = false

		local vsText = ringFolder:FindFirstChild("VsText")
		local label = vsText and vsText:FindFirstChild("Number", true)
		if label then
			local countdownVal = tonumber(label.Text)
			if countdownVal and (countdownVal > 0 or label.Text == "0") then 
				hasActiveCountdown = true 
			end
		end

		for _, m in ipairs(ringFolder:GetChildren()) do
			if m:IsA("Model") and m.Name == "DuelPad" then
				local occ, cap, amIHere = getPadStats(m)
				-- 'occ' is strictly the number of OTHER players
				ringOtherOccupants = ringOtherOccupants + occ
				totalCapacity = totalCapacity + cap
				
				if amIHere then 
					amIInThisRing = true 
				end
				
				if not potentialPad and occ < cap then 
					potentialPad = m:FindFirstChild("Pad") 
				end
			end
		end

		if potentialPad or amIInThisRing then
			-- THE MAGIC FORMULA:
			-- If I take a spot, how many MORE players do we need to wait for?
			local playersToWaitFor = totalCapacity - ringOtherOccupants - 1
			if playersToWaitFor < 0 then playersToWaitFor = 0 end
			
			-- Priority 1: Minimize playersToWaitFor (get into matches that start soonest)
			-- Priority 2: Maximize ringOtherOccupants (prefer larger games like 3v3/4v4)
			local score = 20000 - (playersToWaitFor * 2000) + (ringOtherOccupants * 600)
			
			if hasActiveCountdown then 
				score = score + 10000 
			end
			
			if amIInThisRing then
				currentRingScore = score
				if label and label.Text == "0" then 
					isMatchStarting = true 
				end
			end
			
			if score > bestScore and potentialPad then
				bestScore = score
				bestPadTarget = potentialPad
			end
		end
	end

	local effectiveCurrent = (currentRingScore > -10000) and (currentRingScore + Config.Stickiness) or -10000
	if bestScore > effectiveCurrent and bestPadTarget then 
		return bestPadTarget, nil, isMatchStarting 
	end
	
	return nil, nil, isMatchStarting
end

