-- [[ LOOPS ]] --

-- Leech Loop
RunService.Heartbeat:Connect(function()
	if Config.LeechEnabled and Config.LeechTarget and Config.LeechTarget.Character then
		local targetRoot = Config.LeechTarget.Character:FindFirstChild("HumanoidRootPart")
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if targetRoot and myRoot then
			myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.5)
		end
	end
end)

-- Aura Loop
task.spawn(function()
	while true do
		if Config.AuraEnabled then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character and (plr.Team ~= LocalPlayer.Team or plr.Team == nil) then
					pcall(function() fireRemote(plr) end)
				end
			end
		end
		task.wait(Config.AuraDelay)
	end
end)

-- Auto Queue Loop
task.spawn(function()
	while true do
		if Config.AutoQueueEnabled then
			local inLobby = isInLobby()
			if Config.CurrentlyInMatch then
				if inLobby then Config.CurrentlyInMatch = false end
			else
				if not inLobby then Config.CurrentlyInMatch = true end
			end

			if not Config.CurrentlyInMatch then
				local targetPad, _, isStarting = findBestPad()
				if isStarting then 
					Config.CurrentlyInMatch = true 
				elseif targetPad then 
					teleport(targetPad.Position) 
				end
			end
		end
		task.wait(0.4)
	end
end)

-- Spinbot Loop
RunService.Heartbeat:Connect(function()
	if Config.SpinbotEnabled then
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if root then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0) end
	end
end)

-- Draggable UI
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)
UIS.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end end)
RunService.RenderStepped:Connect(function()
	if dragging and dragInput then
		local delta = dragInput.Position - dragStart
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

UIS.InputBegan:Connect(function(input, gpe)
	if not gpe and input.KeyCode == Enum.KeyCode.Delete then
		Main.Visible = not Main.Visible
		PlayerListFrame.Visible = false
	end
end)
